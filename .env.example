# Local SQLite file. Relative paths resolve from the backend working directory.
NETPULSE_DATABASE_URL=sqlite+aiosqlite:///./netpulse.db
NETPULSE_MAX_DEVICES=500
NETPULSE_MAX_CONCURRENCY=32
NETPULSE_FAILURE_THRESHOLD=3
NETPULSE_RECOVERY_THRESHOLD=2
NETPULSE_STALE_SECONDS=180
NETPULSE_LATENCY_THRESHOLD_MS=250
NETPULSE_PACKET_LOSS_THRESHOLD_PERCENT=20
NETPULSE_RETENTION_DAYS=30
# Use the deployed frontend origin in production; keep localhost origins for local Vite.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_URL=http://127.0.0.1:8000
# Optional custom backend domains; Render's default hostname is allowed automatically.
NETPULSE_ALLOWED_HOSTS=
